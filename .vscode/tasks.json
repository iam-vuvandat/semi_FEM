{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Setup Virtual Environment",
            "type": "shell",
            "command": "cmd /c install.bat",
            "runOptions": {
                "runOn": "folderOpen" 
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "group": "none"
        },
        {
            "label": "2. Run Python in .venv",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}  